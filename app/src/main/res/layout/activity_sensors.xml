<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sensor de Movimiento (Acelerómetro):"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_sensor_values"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="X: 0.0 | Y: 0.0 | Z: 0.0"
        android:textSize="18sp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Control Alternativo (Sin el sensor):"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_manual_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simular Acción Manualmente"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado: En espera..."
        android:paddingTop="8dp" />

</LinearLayout>